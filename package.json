{
  "name": "qihang-work-ai",
  "version": "0.1.0",
  "description": "启航AI工作台",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run compile:electron && concurrently \"vite\" \"electron . --dev\"",
    "electron:build": "vite build && npm run compile:electron && npx electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.3",
    "@electron/rebuild": "^4.2.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@rollup/rollup-win32-x64-msvc": "^4.62.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^15.0.0",
    "node-cron": "^4.6.0",
    "ollama": "^0.5.14",
    "pinia": "^3.0.0",
    "sql.js": "^1.14.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "ws": "^8.21.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.qihang.qihang-ai-workbench",
    "productName": "启航AI工作台",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "zip"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
